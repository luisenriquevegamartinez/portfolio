---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import avatar from '../assets/avatar.png';
import { withBase } from '../lib/url';
import {
  formatRange,
  formatYearRange,
  getEducation,
  getExperience,
  getProfile,
  getSkills,
} from '../lib/content';

const profile = await getProfile();
const experience = await getExperience();
const skills = await getSkills();
const education = await getEducation();

const sectionHeading = 'text-xs font-semibold uppercase tracking-widest text-fg-muted';
---

<BaseLayout
  title={`${profile.name} — Frontend Developer`}
  description={`Frontend developer with ${profile.yearsExperience} years of experience in Angular, TypeScript and microfrontend architectures.`}
>
  <div class="mx-auto w-full max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <header>
      <div class="flex items-center gap-4">
        <Image
          src={avatar}
          alt=""
          width={64}
          height={64}
          class="h-16 w-16 rounded-full border border-border-default"
          loading="eager"
        />
        <div>
          <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
            {profile.name}
          </h1>
          <p class="text-sm text-fg-muted">{profile.location}</p>
        </div>
      </div>

      <p class="mt-6 text-base text-fg-muted">{profile.headline}</p>
      <p class="mt-4 text-pretty">{profile.summary}</p>

      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a
          href={withBase('/resume.pdf')}
          class="rounded-md border border-border-default bg-canvas-subtle px-4 py-2 text-sm font-medium text-fg transition-colors hover:border-fg-muted"
          download
        >
          Download resume (PDF)
        </a>
        <a href={withBase('/resume')} class="text-sm text-accent hover:underline">
          View resume
        </a>
        {
          profile.links.map((link) => (
            <a href={link.url} class="text-sm text-accent hover:underline">
              {link.label}
            </a>
          ))
        }
        <a href={`mailto:${profile.email}`} class="text-sm text-accent hover:underline">
          {profile.email}
        </a>
      </div>
    </header>

    <main id="main">
      <section class="mt-16 border-t border-border-muted pt-10" aria-labelledby="experience">
        <h2 id="experience" class={sectionHeading}>Experience</h2>

        <div class="mt-8 space-y-12">
          {
            experience.map((entry) => (
              <article>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="text-lg font-semibold tracking-tight">
                    {entry.data.role}
                    <span class="font-normal text-fg-muted"> · {entry.data.company}</span>
                  </h3>
                  <p class="font-mono text-xs text-fg-muted">
                    {formatRange(entry.data.start, entry.data.end)}
                  </p>
                </div>
                <p class="mt-1 text-sm text-fg-muted">{entry.data.location}</p>

                <dl class="mt-5 space-y-4">
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wider text-fg-muted">
                      Problem
                    </dt>
                    <dd class="mt-1 text-pretty">{entry.data.caseStudy.problem}</dd>
                  </div>
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wider text-fg-muted">
                      Decision
                    </dt>
                    <dd class="mt-1 text-pretty">{entry.data.caseStudy.decision}</dd>
                  </div>
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wider text-fg-muted">
                      Result
                    </dt>
                    <dd class="mt-1 text-pretty">{entry.data.caseStudy.result}</dd>
                  </div>
                </dl>

                {entry.data.stack.length > 0 && (
                  <p class="mt-5 font-mono text-xs text-fg-muted">
                    {entry.data.stack.join(' · ')}
                  </p>
                )}

                {entry.data.links.length > 0 && (
                  <p class="mt-3 text-sm">
                    {entry.data.links.map((link, i) => (
                      <>
                        {i > 0 && <span class="text-fg-muted"> · </span>}
                        <a
                          href={link.url}
                          class="text-accent hover:underline"
                          rel="noopener noreferrer"
                          target="_blank"
                        >
                          {link.label}
                        </a>
                      </>
                    ))}
                  </p>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section class="mt-16 border-t border-border-muted pt-10" aria-labelledby="skills">
        <h2 id="skills" class={sectionHeading}>Skills</h2>
        <dl class="mt-8 space-y-5">
          {
            skills.map((group) => (
              <div class="sm:grid sm:grid-cols-[10rem_1fr] sm:gap-6">
                <dt class="text-sm font-medium text-fg-muted">{group.data.label}</dt>
                <dd class="mt-1 text-pretty sm:mt-0">{group.data.items.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="mt-16 border-t border-border-muted pt-10" aria-labelledby="education">
        <h2 id="education" class={sectionHeading}>Education</h2>
        <ul class="mt-8 space-y-5">
          {
            education.map((entry) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4">
                <div>
                  <p class="font-medium">{entry.data.degree}</p>
                  <p class="text-sm text-fg-muted">{entry.data.institution}</p>
                </div>
                <p class="font-mono text-xs text-fg-muted">
                  {formatYearRange(entry.data.start, entry.data.end)}
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <footer class="mt-16 border-t border-border-muted pt-8 text-sm text-fg-muted">
      <p>
        Open to remote frontend roles. Reach me at{' '}
        {/* Underlined, not just coloured: a link sitting inside a sentence must be
            distinguishable without relying on colour (WCAG 1.4.1). */}
        <a
          href={`mailto:${profile.email}`}
          class="text-accent underline underline-offset-2"
        >
          {profile.email}
        </a>.
      </p>
    </footer>
  </div>
</BaseLayout>
