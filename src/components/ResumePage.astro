---
/**
 * Source of the generated PDF (scripts/generate-resume-pdf.mjs runs Chromium over this
 * page, once per locale). Deliberately plain CSS rather than utility classes: this output
 * is parsed by ATS software, so the markup stays a single column of semantic text with no
 * grid, no table, no icon standing in for a contact field, and no decorative element.
 *
 * It renders black on white in every medium, not only in print. A dark screen theme with
 * a print override is one more layer that can go wrong between here and the PDF.
 */
import { withBase } from '../lib/url';
import { localePath, t, type Locale } from '../i18n/config';
import {
  formatRange,
  formatYearRange,
  getEducation,
  getProfile,
  getResumeExperience,
  getSkills,
} from '../lib/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tr = t(lang);

const profile = await getProfile();
const experience = await getResumeExperience();
const skills = await getSkills(true);
const education = await getEducation(true);

const contact = [
  profile.email,
  profile.location,
  ...profile.links.map((l) => l.url.replace(/^https?:\/\/(www\.)?/, '')),
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} — {lang === 'es' ? 'CV' : 'Resume'}</title>
    <meta name="description" content={tr('meta.description')(profile.yearsExperience)} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <a class="back" href={withBase(localePath(lang, '/'))}>{tr('resume.back')}</a>

    <main>
      <header>
        <h1>{profile.name}</h1>
        <p class="headline">{profile.headline[lang]}</p>
        <p class="contact">{contact.join(' · ')}</p>
        <p class="summary">{profile.summary[lang]}</p>
      </header>

      <section>
        <h2>{tr('section.experience')}</h2>
        {
          experience.map((entry) => (
            <div class="role">
              {entry.data.resume === 'full' ? (
                <>
                  <p class="role-line">
                    <strong>{entry.data.role[lang]}</strong>, {entry.data.company}{' '}
                    <span class="dates">— {formatRange(entry.data.start, entry.data.end, lang)}</span>
                  </p>
                  <ul>
                    {entry.data.highlights[lang].map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </>
              ) : (
                <p class="compact">
                  <strong>{entry.data.role[lang]}</strong>, {entry.data.company}{' '}
                  <span class="dates">
                    — {formatRange(entry.data.start, entry.data.end, lang)}.
                  </span>{' '}
                  {entry.data.oneLine?.[lang]}
                </p>
              )}
            </div>
          ))
        }
      </section>

      <section>
        <h2>{tr('section.skills')}</h2>
        {
          skills.map((group) => (
            <p class="skill-line">
              <strong>{group.data.label[lang]}:</strong> {group.data.items.join(', ')}
            </p>
          ))
        }
        {/* Languages live under Skills rather than in their own section: it is one line
            of content, and a whole heading for it would cost more page than it earns. */}
        <p class="skill-line">
          <strong>{tr('section.languages')}:</strong> {profile.languages[lang].join(', ')}
        </p>
      </section>

      <section>
        <h2>{tr('section.education')}</h2>
        {
          education.map((entry) => (
            <p class="edu-line">
              <strong>{entry.data.degree[lang]}</strong>, {entry.data.institution}{' '}
              <span class="dates">— {formatYearRange(entry.data.start, entry.data.end, lang)}</span>
            </p>
          ))
        }
      </section>
    </main>
  </body>
</html>

<style is:global>
  /*
    Explicit font stack, not a system stack. The PDF is generated by Chromium on a Linux
    CI runner that has neither Segoe UI nor SF Pro, so "system font" would make the output
    differ between a local run and the pipeline. Liberation Sans is metric-compatible with
    Arial, which is what keeps the page count stable across the two.
  */
  :root {
    --ink: #000000;
    --muted: #333333;
    --rule: #999999;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: #ffffff;
  }

  body {
    margin: 0 auto;
    max-width: 190mm;
    padding: 16mm 14mm;
    background: #ffffff;
    color: var(--ink);
    font-family: Arial, Helvetica, 'Liberation Sans', sans-serif;
    font-size: 9.6pt;
    line-height: 1.28;
    font-variant-ligatures: none;
  }

  .back {
    display: inline-block;
    margin-bottom: 10mm;
    color: #0b5cad;
    font-size: 9pt;
  }

  h1 {
    margin: 0;
    font-size: 17pt;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .headline {
    margin: 1.5mm 0 0;
    font-size: 10pt;
  }

  .contact {
    margin: 1.5mm 0 0;
    color: var(--muted);
    font-size: 9pt;
  }

  .summary {
    margin: 2.5mm 0 0;
  }

  h2 {
    margin: 3.4mm 0 1.4mm;
    padding-bottom: 0.8mm;
    border-bottom: 0.7pt solid var(--rule);
    font-size: 10.5pt;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  section > p {
    margin: 0;
  }

  .role {
    margin-bottom: 1.7mm;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .role:last-child {
    margin-bottom: 0;
  }

  .role-line,
  .compact,
  .skill-line,
  .edu-line {
    margin: 0;
  }

  .compact + .compact,
  .skill-line + .skill-line,
  .edu-line + .edu-line {
    margin-top: 1.2mm;
  }

  /*
    Dates stay inline, in document order, immediately after the employer they belong to.
    An earlier version floated them flush right, which looked better and was wrong: the
    PDF text layer then began with every date in a block, detached from its role, before
    the candidate's own name. Reading order is what a parser consumes, so reading order wins.
  */
  .dates {
    color: var(--muted);
    white-space: nowrap;
  }

  ul {
    margin: 1mm 0 0;
    padding-left: 4.6mm;
  }

  li {
    margin-bottom: 0.6mm;
  }

  @page {
    size: letter;
    margin: 12mm;
  }

  @media print {
    .back {
      display: none;
    }

    body {
      max-width: none;
      padding: 0;
    }
  }
</style>
