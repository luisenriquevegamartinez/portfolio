---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageToggle from './LanguageToggle.astro';
import avatar from '../assets/avatar.png';
import { withBase } from '../lib/url';
import { localePath, resumeDownloadName, resumeFile, t, type Locale } from '../i18n/config';
import {
  formatRange,
  formatYearRange,
  getEducation,
  getExperience,
  getProfile,
  getSkills,
} from '../lib/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tr = t(lang);

const profile = await getProfile();
const experience = await getExperience();
const skills = await getSkills();
const education = await getEducation();

const sectionHeading = 'text-xs font-semibold uppercase tracking-widest text-fg-muted';
---

<BaseLayout
  lang={lang}
  route="/"
  title={`${profile.name} — ${profile.headline[lang].split('|')[0].trim()}`}
  description={tr('meta.description')(profile.yearsExperience)}
>
  <div class="mx-auto w-full max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <header>
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-center gap-4">
          <Image
            src={avatar}
            alt=""
            width={64}
            height={64}
            class="h-16 w-16 rounded-full border border-border-default"
            loading="eager"
          />
          <div>
            <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              {profile.name}
            </h1>
            <p class="text-sm text-fg-muted">{profile.location}</p>
          </div>
        </div>
        <LanguageToggle lang={lang} route="/" />
      </div>

      <p class="mt-6 text-base text-fg-muted">{profile.headline[lang]}</p>
      <p class="mt-4 text-pretty">{profile.summary[lang]}</p>

      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
        {/* Dated href so a direct "save as" keeps the name too, plus `download` for the
            click path. An undated alias is written next to it so old links never 404. */}
        <a
          href={encodeURI(withBase(resumeFile(lang)))}
          class="rounded-md border border-border-default bg-canvas-subtle px-4 py-2 text-sm font-medium text-fg transition-colors hover:border-fg-muted"
          download={resumeDownloadName(lang)}
        >
          {tr('action.download')}
        </a>
        <a href={withBase(localePath(lang, '/resume'))} class="text-sm text-accent hover:underline">
          {tr('action.view')}
        </a>
        {
          profile.links.map((link) => (
            <a href={link.url} class="text-sm text-accent hover:underline">
              {link.label}
            </a>
          ))
        }
        <a href={`mailto:${profile.email}`} class="text-sm text-accent hover:underline">
          {profile.email}
        </a>
      </div>
    </header>

    <main id="main">
      <section class="mt-16 border-t border-border-muted pt-10" aria-labelledby="experience">
        <h2 id="experience" class={sectionHeading}>{tr('section.experience')}</h2>

        <div class="mt-8 space-y-12">
          {
            experience.map((entry) => (
              <article>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="text-lg font-semibold tracking-tight">
                    {entry.data.role[lang]}
                    <span class="font-normal text-fg-muted"> · {entry.data.company}</span>
                  </h3>
                  <p class="font-mono text-xs text-fg-muted">
                    {formatRange(entry.data.start, entry.data.end, lang)}
                  </p>
                </div>
                <p class="mt-1 text-sm text-fg-muted">{entry.data.location[lang]}</p>

                <dl class="mt-5 space-y-4">
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wider text-fg-muted">
                      {tr('case.problem')}
                    </dt>
                    <dd class="mt-1 text-pretty">{entry.data.caseStudy[lang].problem}</dd>
                  </div>
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wider text-fg-muted">
                      {tr('case.decision')}
                    </dt>
                    <dd class="mt-1 text-pretty">{entry.data.caseStudy[lang].decision}</dd>
                  </div>
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wider text-fg-muted">
                      {tr('case.result')}
                    </dt>
                    <dd class="mt-1 text-pretty">{entry.data.caseStudy[lang].result}</dd>
                  </div>
                </dl>

                {entry.data.stack.length > 0 && (
                  <p class="mt-5 font-mono text-xs text-fg-muted">
                    {entry.data.stack.join(' · ')}
                  </p>
                )}

                {entry.data.links.length > 0 && (
                  <p class="mt-3 text-sm">
                    {entry.data.links.map((link, i) => (
                      <>
                        {i > 0 && <span class="text-fg-muted"> · </span>}
                        <a
                          href={link.url}
                          class="text-accent hover:underline"
                          rel="noopener noreferrer"
                          target="_blank"
                        >
                          {link.label}
                        </a>
                      </>
                    ))}
                  </p>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section class="mt-16 border-t border-border-muted pt-10" aria-labelledby="skills">
        <h2 id="skills" class={sectionHeading}>{tr('section.skills')}</h2>
        <dl class="mt-8 space-y-5">
          {
            skills.map((group) => (
              <div class="sm:grid sm:grid-cols-[11rem_1fr] sm:gap-6">
                <dt class="text-sm font-medium text-fg-muted">{group.data.label[lang]}</dt>
                <dd class="mt-1 text-pretty sm:mt-0">{group.data.items.join(', ')}</dd>
              </div>
            ))
          }
          <div class="sm:grid sm:grid-cols-[11rem_1fr] sm:gap-6">
            <dt class="text-sm font-medium text-fg-muted">{tr('section.languages')}</dt>
            <dd class="mt-1 text-pretty sm:mt-0">{profile.languages[lang].join(', ')}</dd>
          </div>
        </dl>
      </section>

      <section class="mt-16 border-t border-border-muted pt-10" aria-labelledby="education">
        <h2 id="education" class={sectionHeading}>{tr('section.education')}</h2>
        <ul class="mt-8 space-y-5">
          {
            education.map((entry) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4">
                <div>
                  <p class="font-medium">{entry.data.degree[lang]}</p>
                  <p class="text-sm text-fg-muted">{entry.data.institution}</p>
                </div>
                <p class="font-mono text-xs text-fg-muted">
                  {formatYearRange(entry.data.start, entry.data.end, lang)}
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <footer class="mt-16 border-t border-border-muted pt-8 text-sm text-fg-muted">
      <p>
        {tr('footer.open')}{' '}
        {/* Underlined, not just coloured: a link sitting inside a sentence must be
            distinguishable without relying on colour (WCAG 1.4.1). */}
        <a
          href={`mailto:${profile.email}`}
          class="text-accent underline underline-offset-2"
        >
          {profile.email}
        </a>.
      </p>
    </footer>
  </div>
</BaseLayout>
